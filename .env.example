# ClaudeOneNoteGraph の公開設定の例。値はすべて架空のプレースホルダーです。
# コピーして .env（Git対象外）にし、自分のアプリID・テナントIDを書きます。
# トークン・パスワード・クライアントシークレットは書きません（書くと拒否します）。
# 使い方: python3 onenote.py --env-file .env status
# 書式は KEY=value だけ。空白を含む値は "…" で囲みます。変数展開（$、~）はしません。

ONENOTE_CLIENT_ID=00000000-0000-0000-0000-000000000000
ONENOTE_TENANT=organizations
ONENOTE_NOTES_SCOPE=Notes.ReadWrite

# file = このPCの利用者ごとのフォルダに保存（明示した時だけ）。WindowsはDPAPIで暗号化、macOS・Linuxは平文。keychain = macOS Keychain（既定）。
ONENOTE_AUTH_STORE=file
# 空欄なら既定の場所: macOS ~/Library/Application Support/ClaudeOneNoteGraph/token-cache
# Windows %LOCALAPPDATA%\ClaudeOneNoteGraph\token-cache。指定する場合はGit・OneDriveの外の絶対パス。
ONENOTE_TOKEN_CACHE_DIR=
# 作成ページ・同期メモに記録するパソコン名。空欄ならコンピューター名。
ONENOTE_MACHINE=

# 接続先は通常 --config のJSONから読みます。JSONなしで使う場合だけ有効にします。
# ONENOTE_ROOT=me
# ONENOTE_SECTION_ID=
